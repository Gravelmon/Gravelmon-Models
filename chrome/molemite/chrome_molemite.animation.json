				},
				"orbit": {
					"rotation": [0, "(query.anim_time)*45", 0]
				},
				"orbit_electron": {
					"rotation": [0, "(query.anim_time)*55", 0]
				},
				"nail_left_rotation": {
					"rotation": ["2+15*math.cos(query.anim_time*90*1)", 0, 0]
				},
				"nail_right_rotation": {
					"rotation": ["2+15*math.cos(query.anim_time*90*1)", 0, 0]
				},
				"electron_left": {
					"rotation": [0, 0, "5*math.cos(query.anim_time*90*1)"]
