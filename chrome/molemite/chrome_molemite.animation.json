				"electron_right": {
					"rotation": [0, 0, "5*math.cos(query.anim_time*90*1)"]
				}
			}
		},
		"animation.chrome_molemite.air_fly": {
			"loop": true,
			"bones": {
				"body": {
					"rotation": [15, "0 - Math.cos(((q.anim_time + 0.1) * 180 * 0.5) * 1) * 5", "Math.cos(((q.anim_time + 0.4) * 180 * 0.5) * 1) * 5"],
					"position": ["Math.cos((q.anim_time * 90 * 0.5) * 1) * 1.5", "1+Math.cos((q.anim_time * 180 * 0.5) * 1) * 1", 0]
				},
				"orbit": {
